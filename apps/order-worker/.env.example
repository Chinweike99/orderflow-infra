# Order Worker configuration. Every variable is validated at startup
# (src/config/env.validation.ts). Locally, the worker reads .env from this
# folder or from the repository root. In containers/Kubernetes, set real env vars.

NODE_ENV=development
LOG_LEVEL=info
WORKER_PORT=3001

# PostgreSQL (same database as the Order API)
DB_HOST=localhost
DB_PORT=5432
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=orderflow
# true for Amazon RDS
DB_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://change-me:change-me@localhost:5672

# Processing
WORKER_PREFETCH=10
WORKER_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_TIMEOUT_MS=20000

# Simulated payment provider
PAYMENT_DECLINE_RATE=0.1
PAYMENT_ERROR_RATE=0.1
PAYMENT_MIN_LATENCY_MS=200
PAYMENT_MAX_LATENCY_MS=1000
