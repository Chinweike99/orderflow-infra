# Copy to .env and replace the placeholder values:  cp .env.example .env
# .env is ignored by Git. Never commit real values.

# --- Read by the containers (docker-compose.yml) ---
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orderflow
# host port for PostgreSQL (5432/5433 are used by local installs)
POSTGRES_HOST_PORT=5434
RABBITMQ_DEFAULT_USER=orderflow
RABBITMQ_DEFAULT_PASS=change-me

# --- Read by the Order API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DB_HOST=localhost
# must match POSTGRES_HOST_PORT
DB_PORT=5434
# same as POSTGRES_USER
DB_USER=orderflow
# same as POSTGRES_PASSWORD
DB_PASSWORD=change-me
# same as POSTGRES_DB
DB_NAME=orderflow
DB_SSL=false
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN_SECONDS=3600
CURRENCY=USD
RABBITMQ_URL=amqp://orderflow:change-me@localhost:5672

# --- Read by the Order Worker (all optional; defaults shown) ---
# The worker shares the variables above (DB_*, RABBITMQ_URL, LOG_LEVEL, NODE_ENV).
# It uses WORKER_PORT, not PORT, so both services can run from this one file.
WORKER_PORT=3001
WORKER_PREFETCH=10
WORKER_MAX_ATTEMPTS=3
# Simulated payment provider: share of payments declined / failing temporarily
PAYMENT_DECLINE_RATE=0.1
PAYMENT_ERROR_RATE=0.1
PAYMENT_MIN_LATENCY_MS=200
PAYMENT_MAX_LATENCY_MS=1000
