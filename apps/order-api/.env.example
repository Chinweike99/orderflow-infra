# Order API configuration. Every variable is validated at startup
# (src/config/env.validation.ts). Locally, the API reads .env from this folder
# or from the repository root. In containers/Kubernetes, set real env vars.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=orderflow
# true for Amazon RDS
DB_SSL=false

# Authentication. Generate a secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600

CURRENCY=USD

# RabbitMQ (used from Sprint 2)
RABBITMQ_URL=amqp://change-me:change-me@localhost:5672
